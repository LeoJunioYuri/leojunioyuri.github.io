    "end": "Anderson's alerts arrive as push notifications on the owner's phone."
  },
  {
    "d": 724,
    "kind": "ship",
    "pt": "Banco próprio",
    "en": "Own database",
    "ptd": "Cutover do Ads para um banco de aquisição dedicado, com janela de manutenção e deleção do legado.",
    "end": "Ads cuts over to a dedicated acquisition database, with a maintenance window and legacy deletion."
  },
  {
    "d": 730,
    "kind": "life",
    "pt": "Dia 730",
    "en": "Day 730",
    "ptd": "Hoje. 2.171 lojas anunciando, 1.894 vendendo via anúncio na última semana fechada. E contando.",
    "end": "Today. 2,171 stores advertising, 1,894 selling through ads in the last closed week. And counting.",
    "key": true
  }
];

const t =
  lang === "en"
    ? {
        title: "Drag through the 730 days",
        day: "Day {n} of 730",
        adv: "stores advertising that week",
        sell: "selling through ads",
        sellNa: "not measured yet",
        prs: "PRs merged so far (all repos)",
        live: "Latest",
        bad: "Went wrong nearby",
        none: "Nothing on fire. Enjoy it.",
        hint: "Drag, use the arrow keys, or jump to a milestone.",
        locale: "en-US",
        legendAdv: "advertising",
        legendSell: "selling via ads",
      }
    : {
        title: "Arraste pelos 730 dias",
        day: "Dia {n} de 730",
        adv: "lojas anunciando na semana",
        sell: "vendendo via anúncio",
        sellNa: "ainda não medido",
        prs: "PRs merged até aqui (todos os repos)",
        live: "O último lançamento",
        bad: "Deu ruim por perto",
        none: "Nada pegando fogo. Aproveite.",
        hint: "Arraste, use as setas do teclado ou pule para um marco.",
        locale: "pt-BR",
        legendAdv: "anunciando",
        legendSell: "vendendo via anúncio",
      };

const evs = events.map((e) => ({
  d: e.d,
  kind: e.kind,
  key: !!e.key,
  name: lang === "en" ? e.en : e.pt,
  desc: lang === "en" ? e.end : e.ptd,
}));
const W = 640, H = 140, MAXY = 2200;
const keyEvs = evs.filter((e) => e.key);
---

<figure class="sd" data-sd>
  <div class="sd-head">
    <p class="sd-title">{t.title}</p>
    <p class="sd-date" data-date></p>
  </div>
  <p class="sd-day" data-day></p>

  <div class="sd-stats">
    <div><b data-adv>0</b><span>{t.adv}</span></div>
    <div><b data-sell>0</b><span>{t.sell}</span></div>
    <div><b data-prs>0</b><span>{t.prs}</span></div>
  </div>

  <svg class="sd-chart" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-hidden="true">
    <path class="sd-ghost" data-ghost-adv d="" />
    <path class="sd-adv" data-path-adv d="" />
    <path class="sd-sell" data-path-sell d="" />
    {evs.filter((e) => e.kind === "bad").map((e) => (
      <line class="sd-badline" x1={(e.d / 730) * W} x2={(e.d / 730) * W} y1="0" y2={H} />
    ))}
    <line class="sd-cursor" data-cursor x1="0" x2="0" y1="0" y2={H} />
  </svg>
  <div class="sd-legend">
    <span><i class="adv"></i>{t.legendAdv}</span>
    <span><i class="sell"></i>{t.legendSell}</span>
    <span><i class="bad"></i>{t.bad}</span>
  </div>

  <input class="sd-range" data-range type="range" min="1" max="730" step="1" value="1" aria-label={t.title} />

  <div class="sd-marks">
    {keyEvs.map((e) => (
      <button type="button" data-jump={Math.max(1, e.d)}>{e.name}</button>
    ))}
  </div>

  <div class="sd-cards">
    <div class="sd-card">
      <p class="sd-label">{t.live}</p>
      <p class="sd-name" data-live-name></p>
      <p class="sd-desc" data-live-desc></p>
    </div>
    <div class="sd-card bad" data-bad-card>
      <p class="sd-label">{t.bad}</p>
      <p class="sd-name" data-bad-name></p>
      <p class="sd-desc" data-bad-desc></p>
    </div>
  </div>
  <figcaption>{t.hint}</figcaption>
</figure>

<script is:inline define:vars={{ weeks, prsByMonth, evs, t, W, H, MAXY }}>
  (() => {
    const root = document.querySelector("[data-sd]:not([data-ready])");
    if (!root) return;
    root.setAttribute("data-ready", "");
    const $ = (s) => root.querySelector(s);
    const range = $("[data-range]");
    const START = Date.UTC(2024, 9, 21);
    const fmt = new Intl.NumberFormat(t.locale);
    const fmtDate = new Intl.DateTimeFormat(t.locale, { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" });

    const x = (d) => (d / 730) * W;
    const y = (v) => H - (v / MAXY) * (H - 6);
    const pathTo = (idx, day) => {
      const pts = weeks.filter((w) => w[0] <= day);
      if (!pts.length) return "";
      return pts.map((w, i) => `${i ? "L" : "M"}${x(w[0]).toFixed(1)},${y(w[idx]).toFixed(1)}`).join("");
    };
    $("[data-ghost-adv]").setAttribute("d", pathTo(1, 730));

    // PRs acumuladas: cada mês é distribuído linearmente pelos seus dias.
    const prsAt = (day) => {
      const date = new Date(START + day * 864e5);
      const mi = (date.getUTCFullYear() - 2024) * 12 + date.getUTCMonth() - 9;
      let acc = 0;
      for (let i = 0; i < mi && i < prsByMonth.length; i++) acc += prsByMonth[i];
      if (mi >= prsByMonth.length) return acc;
      const dim = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + 1, 0)).getUTCDate();
      const lastDay = mi === prsByMonth.length - 1 ? 21 : dim;
      const firstDay = mi === 0 ? 21 : 1;
      const frac = Math.min(1, Math.max(0, (date.getUTCDate() - firstDay + 1) / (lastDay - firstDay + 1)));
      return Math.round(acc + prsByMonth[mi] * frac);
    };

    const render = () => {
      const day = Number(range.value);
      const offset = day - 1 === 729 ? 730 : day - 1;
      $("[data-day]").textContent = t.day.replace("{n}", day);
      $("[data-date]").textContent = fmtDate.format(new Date(START + offset * 864e5));
      const wk = [...weeks].reverse().find((w) => w[0] <= offset) || weeks[0];
      $("[data-adv]").textContent = fmt.format(wk[1]);
      $("[data-sell]").textContent = wk[2] ? fmt.format(wk[2]) : "—";
      $("[data-sell]").title = wk[2] ? "" : t.sellNa;
      $("[data-prs]").textContent = fmt.format(prsAt(offset));
      $("[data-path-adv]").setAttribute("d", pathTo(1, offset));
      $("[data-path-sell]").setAttribute("d", pathTo(2, offset));
      const c = $("[data-cursor]");
      c.setAttribute("x1", x(offset)); c.setAttribute("x2", x(offset));

      const live = [...evs].reverse().find((e) => e.kind !== "bad" && e.d <= offset) || evs[0];
      $("[data-live-name]").textContent = live.name;
      $("[data-live-desc]").textContent = live.desc;
      const bad = evs.find((e) => e.kind === "bad" && Math.abs(e.d - offset) <= 10);
      const card = $("[data-bad-card]");
      card.classList.toggle("on", !!bad);
      $("[data-bad-name]").textContent = bad ? bad.name : "";
      $("[data-bad-desc]").textContent = bad ? bad.desc : t.none;
      range.style.setProperty("--p", `${((day - 1) / 729) * 100}%`);
    };

    range.addEventListener("input", render);
    root.querySelectorAll("[data-jump]").forEach((b) =>
      b.addEventListener("click", () => { range.value = b.dataset.jump; render(); range.focus(); }),
    );
    render();
  })();
</script>

<style>
  .sd{margin:2rem 0;padding:20px 22px;border:1px solid var(--border);background:var(--surface);border-radius:6px}
  .sd p{margin:0}
  .sd-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
  .sd-title{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
  .sd-date{font-family:var(--font-mono);font-size:12px;color:var(--muted)}
  .sd-day{font-size:clamp(28px,6vw,44px);font-weight:800;letter-spacing:-.02em;line-height:1.1;margin-top:6px!important;font-variant-numeric:tabular-nums}
  .sd-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:14px 0}
  .sd-stats div{min-width:0}
  .sd-stats b{display:block;font-family:var(--font-mono);font-size:clamp(18px,4vw,26px);font-variant-numeric:tabular-nums}
  .sd-stats span{display:block;font-size:12px;line-height:1.3;color:var(--muted);margin-top:2px}
  .sd-chart{width:100%;height:120px;display:block;overflow:visible}
  .sd-ghost{fill:none;stroke:var(--border);stroke-width:2}
  .sd-adv{fill:none;stroke:var(--muted);stroke-width:2}
  .sd-sell{fill:none;stroke:var(--accent);stroke-width:2.5}
  .sd-badline{stroke:var(--accent);stroke-width:1;stroke-dasharray:2 3;opacity:.45}
  .sd-cursor{stroke:var(--fg);stroke-width:1}
  .sd-legend{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:11px;color:var(--muted);margin-top:6px}
  .sd-legend i{display:inline-block;width:14px;height:2px;margin-right:6px;vertical-align:middle;background:var(--muted)}
  .sd-legend i.sell{background:var(--accent);height:3px}
  .sd-legend i.bad{background:none;border-top:1px dashed var(--accent)}
  .sd-range{width:100%;margin:16px 0 10px;accent-color:var(--accent);height:28px;cursor:pointer}
  .sd-range:focus-visible{outline:2px solid var(--ring);outline-offset:4px}
  .sd-marks{display:flex;flex-wrap:wrap;gap:6px}
  .sd-marks button{font:600 11px var(--font-sans);padding:5px 10px;border:1px solid var(--border);background:var(--bg);color:var(--fg);border-radius:999px;cursor:pointer}
  .sd-marks button:hover{border-color:var(--accent)}
  .sd-marks button:focus-visible{outline:2px solid var(--ring);outline-offset:2px}
  .sd-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}
  .sd-card{padding:12px 14px;border:1px solid var(--border);background:var(--bg);border-radius:4px;min-width:0;min-height:7.5em}
  .sd-card.bad{opacity:.55}
  .sd-card.bad.on{opacity:1;border-color:var(--accent)}
  .sd-label{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
  .sd-name{font-weight:700;margin-top:4px!important}
  .sd-desc{font-size:13px;color:var(--muted);margin-top:4px!important;line-height:1.45}
  .sd figcaption{font-size:12px;color:var(--muted);margin-top:12px}
  @media (max-width:560px){.sd{padding:16px}.sd-cards{grid-template-columns:1fr}.sd-stats span{font-size:11px}}
</style>
