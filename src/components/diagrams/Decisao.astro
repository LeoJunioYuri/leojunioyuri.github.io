---
/**
 * Cartão do livro de decisões: o que decidimos, o que estava na mesa, o que deixamos de lado
 * e o que aconteceu depois. O texto livre do slot vira o "o que aconteceu".
 */
import type { Lang } from "@/consts";
interface Props {
  lang: Lang;
  n: number;
  when: string;
  title: string;
  bet: string;
  rejected: string;
}
const { lang, n, when, title, bet, rejected } = Astro.props;
const t =
  lang === "en"
    ? { bet: "The bet", rejected: "What we left on the table", after: "What happened" }
    : { bet: "A aposta", rejected: "O que ficou na mesa", after: "O que aconteceu" };
---

<section class="dc not-prose">
  <header>
    <span class="dc-n">{String(n).padStart(2, "0")}</span>
    <span class="dc-when">{when}</span>
  </header>
  <h3>{title}</h3>
  <dl>
    <div><dt>{t.bet}</dt><dd>{bet}</dd></div>
    <div><dt>{t.rejected}</dt><dd>{rejected}</dd></div>
    <div class="after"><dt>{t.after}</dt><dd><slot /></dd></div>
  </dl>
</section>

<style>
  .dc{margin:1.25rem 0;padding:18px 20px;border:1px solid var(--border);border-left:3px solid var(--accent);background:var(--surface);border-radius:4px}
  .dc header{display:flex;gap:12px;align-items:baseline}
  .dc-n{font-family:var(--font-mono);font-weight:700;color:var(--accent)}
  .dc-when{font-family:var(--font-mono);font-size:12px;color:var(--muted)}
  .dc h3{margin:6px 0 10px;font-size:1.1rem;line-height:1.3;font-weight:700}
  .dc dl{margin:0;display:grid;gap:8px}
  .dc dt{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
  .dc dd{margin:2px 0 0;font-size:15px;line-height:1.5}
  .dc .after dd{color:var(--fg)}
  .dc .after dd :global(p){margin:0}
</style>
